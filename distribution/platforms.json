{
  "name": "sealos",
  "version": "2.0.0",
  "repository": "https://github.com/labring/sealos-skills",
  "platforms": [
    {
      "id": "codex",
      "runtime": "plugin",
      "claim": "install-target",
      "manifest": "plugins/sealos/.codex-plugin/plugin.json",
      "invoke": "$sealos"
    },
    {
      "id": "claude-code",
      "runtime": "plugin",
      "claim": "install-target",
      "manifest": "plugins/sealos/.claude-plugin/plugin.json",
      "invoke": "/sealos"
    },
    {
      "id": "cursor",
      "runtime": "plugin",
      "claim": "install-target",
      "manifest": "plugins/sealos/.cursor-plugin/plugin.json",
      "invoke": "natural language"
    },
    {
      "id": "qoder",
      "runtime": "plugin",
      "claim": "install-target",
      "manifest": "plugins/sealos/.qoder-plugin/plugin.json",
      "invoke": "/sealos"
    },
    {
      "id": "codebuddy",
      "runtime": "plugin",
      "claim": "install-target",
      "manifest": ".codebuddy-plugin/marketplace.json",
      "invoke": "natural language"
    },
    {
      "id": "openclaw",
      "runtime": "plugin-directory",
      "claim": "install-target",
      "manifest": "plugins/sealos/.cursor-plugin/plugin.json",
      "invoke": "natural language"
    },
    {
      "id": "gemini-cli",
      "runtime": "context-extension",
      "claim": "context-only",
      "manifest": "gemini-extension.json",
      "invoke": "natural language"
    },
    {
      "id": "qwen-code",
      "runtime": "context-extension",
      "claim": "context-only",
      "manifest": "qwen-extension.json",
      "invoke": "natural language"
    },
    {
      "id": "skills-sh",
      "runtime": "agent-skills",
      "claim": "install-target",
      "manifest": "skills/",
      "invoke": "use-sealos"
    },
    {
      "id": "brain",
      "runtime": "managed-agent-skills",
      "claim": "requires-live-verification",
      "manifest": "plugins/sealos/skills/sealos-deploy/SKILL.md",
      "invoke": "sealos-deploy"
    },
    {
      "id": "deepseek-harness",
      "runtime": "profile-bundle",
      "claim": "install-target",
      "manifest": "package.json",
      "invoke": "use-sealos"
    },
    {
      "id": "amp-kimi-generic",
      "runtime": "repository-import",
      "claim": "host-dependent",
      "manifest": "CLAUDE.md",
      "invoke": "natural language"
    }
  ]
}
